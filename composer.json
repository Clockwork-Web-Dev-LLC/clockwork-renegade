{
    "name": "clockwork/renegade",
    "description": "Clockwork Renegade connects your WordPress site to Clockwork Control for fleet-wide monitoring, uptime verification, core/plugin/theme updates, and security telemetry.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Clockwork Web Dev, LLC",
            "homepage": "https://clockworkcontrol.com"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "ClockworkRenegade\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClockworkRenegade\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
